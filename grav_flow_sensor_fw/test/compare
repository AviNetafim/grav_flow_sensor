
#include <stdio.h>
#include <string.h>

#include "freertos/FreeRTOS.h"
#include "freertos/task.h"

#include "nvs_flash.h"
#include "esp_log.h"
#include "NetServer.h"

#include "ds3231.h"

// #include "freertos/semphr.h"

      
QueueHandle_t q_protocol_to_main;
QueueHandle_t q_main_to_protocol;
ds3231 rtc;

void reg_action(regs_action& areg_act){
    int i;
    printf("main received register action structure:\n");
    printf("function: %d\n", areg_act.func);
    printf("address: %d\n", areg_act.address);
    printf("config register:"); 
    for (i = 0 ; i < 4 ; i ++) printf("%04x,", areg_act.config[i]);
    printf("\n"); 
    printf("clock register:"); 
    for (i = 0 ; i < 4 ; i ++) printf("%04x, ", areg_act.clock[i]);
    printf("\n");     
    printf("seq register:"); 
    for (i = 0 ; i < 2 ; i ++) printf("%04x,", areg_act.seq[i]);
    printf("\n");     
    printf("log rec register:"); 
    for (i = 0 ; i < 8 ; i ++) printf("%04x,", areg_act.log_rec[i]);
    printf("\n");     
    int action_code = 10 * areg_act.func + areg_act.address;
    printf("action code = %d \n",action_code);
    switch(action_code){
        case 41:                                                         // get rtc  time and date
            rtc.get_time(areg_act.clock);
        break;
        case 61:                                                         // set rtc time and date
            rtc.set_time(areg_act.clock);                                // [sec,min][hour,day][date,month][year]
        break;

    }
}

extern "C" void app_main(void){ 
    struct regs_action main_reg_act;

    // esp_log_level_set("*", ESP_LOG_WARN);                                // Only warnings & errors
    q_protocol_to_main = xQueueCreate(10, sizeof(regs_action));
    q_main_to_protocol = xQueueCreate(10, sizeof(regs_action));
    static NetServer ns(q_main_to_protocol,q_protocol_to_main);

    vTaskDelay(pdMS_TO_TICKS(2000));

    rtc.i2c_init();
    nvs_flash_init();
    esp_netif_init();
    esp_event_loop_create_default();
    ns.wifi_init_ap();
    ns.start_server_task();
    ns.start_protocol_task();
    
    while(true){
        xQueueReceive(q_protocol_to_main, &main_reg_act, portMAX_DELAY);
        reg_action(main_reg_act);
        xQueueSend(q_main_to_protocol, &main_reg_act, portMAX_DELAY);
    }
}